<Window x:Class="MultiNodeDAQ.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MultiNodeDAQ.Desktop" Title="MultiNodeDAQ" Width="1200" Height="930" MinWidth="940" MinHeight="680" Closing="OnClosing">
<DockPanel Margin="10" Background="#F3F5F8">
<Border DockPanel.Dock="Top" Style="{StaticResource Panel}"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Start local service" Click="StartService"/><Button Content="Connection…" Click="Connection"/></StackPanel><StackPanel><TextBlock Text="MultiNodeDAQ" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="ConnectionStatus" Text="Connecting to local recorder…"/></StackPanel></DockPanel></Border>
<Border DockPanel.Dock="Top" Style="{StaticResource Panel}"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="New recording…" Click="StartRecording"/><Button Content="Stop recording…" Click="StopRecording"/><Button Content="Save summary…" Click="SaveSummary"/></StackPanel><TextBlock x:Name="RecordingStatus" Text="Recording status unavailable" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel></Border>
<StatusBar DockPanel.Dock="Bottom"><TextBlock x:Name="Footer" Text="Receiver and recorder run independently of this window."/></StatusBar>
<Expander DockPanel.Dock="Bottom" Header="Events and diagnostics" IsExpanded="True" Margin="4"><ListBox x:Name="Events" Height="75" FontFamily="Consolas" FontSize="11"/></Expander>
<TabControl x:Name="Workspace" SelectionChanged="WorkspaceChanged" Margin="4">
<TabItem Header="Live acquisition"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Style="{StaticResource Panel}"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Sensor fleet" FontWeight="SemiBold"/><ListBox x:Name="Fleet" SelectionChanged="UnitChanged" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Border Padding="4,8" BorderBrush="#E6EAF0" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding Identity}" FontFamily="Consolas" FontSize="10"/><TextBlock Text="{Binding States}" TextWrapping="Wrap"/><TextBlock Text="{Binding Health}" TextWrapping="Wrap" Foreground="{Binding Color}"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
<Border Grid.Row="1" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Recording health" FontWeight="SemiBold"/><TextBlock x:Name="DiskHealth" Text="Unavailable" TextWrapping="Wrap"/></StackPanel></Border>
</Grid>
<Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="200"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<WrapPanel><TextBlock x:Name="SelectedTitle" Text="Select a sensor" FontSize="17" VerticalAlignment="Center"/><Button Content="Unit details…" Click="UnitDetails"/><Button Content="Start sampling" Click="StartSampling"/><Button Content="Stop sampling" Click="StopSampling"/></WrapPanel>
<TextBlock Grid.Row="1" Text="UNSYNCHRONIZED · Local sample counters only. Cross-unit phase unavailable. Calibration / battery / RSSI unavailable." Foreground="#936118" TextWrapping="Wrap"/>
<Border Grid.Row="2" Style="{StaticResource Panel}"><DockPanel><WrapPanel DockPanel.Dock="Top"><TextBlock Text="XYZ waveforms · ADC codes"/><CheckBox x:Name="XVisible" Content="X" IsChecked="True" Margin="7" Checked="AxesChanged" Unchecked="AxesChanged"/><CheckBox x:Name="YVisible" Content="Y" IsChecked="True" Margin="7" Checked="AxesChanged" Unchecked="AxesChanged"/><CheckBox x:Name="ZVisible" Content="Z" IsChecked="True" Margin="7" Checked="AxesChanged" Unchecked="AxesChanged"/><ComboBox x:Name="Span" SelectedIndex="1"><ComboBoxItem Content="50 ms"/><ComboBoxItem Content="100 ms"/><ComboBoxItem Content="500 ms"/></ComboBox><Button x:Name="PauseButton" Content="Pause plots" Click="PausePlots"/></WrapPanel><TextBlock DockPanel.Dock="Bottom" x:Name="WaveHealth" Text="Waiting for samples" TextWrapping="Wrap"/><local:PlotView x:Name="Wave"/></DockPanel></Border>
<Border Grid.Row="3" Style="{StaticResource Panel}"><DockPanel><WrapPanel DockPanel.Dock="Top"><ComboBox x:Name="AnalysisView" SelectedIndex="0" SelectionChanged="AnalysisViewChanged"><ComboBoxItem Content="SCF"/><ComboBoxItem Content="PSD"/><ComboBoxItem Content="ASD"/><ComboBoxItem Content="Spectrogram"/><ComboBoxItem Content="RMS trend"/><ComboBoxItem Content="Band power"/></ComboBox><ComboBox x:Name="AnalysisAxis" SelectedIndex="0" SelectionChanged="AnalysisViewChanged"><ComboBoxItem Content="X axis"/><ComboBoxItem Content="Y axis"/><ComboBoxItem Content="Z axis"/></ComboBox><Button Content="Analysis settings…" Click="AnalysisSettings"/><Button Content="Start / restart Python…" Click="StartPython"/></WrapPanel><TextBlock DockPanel.Dock="Bottom" x:Name="AnalysisHealth" Text="Analysis unavailable; Python is optional" TextWrapping="Wrap"/><local:PlotView x:Name="Spectrum"/></DockPanel></Border>
</Grid></Grid></TabItem>
<TabItem Header="Replay session"><DockPanel>
<WrapPanel DockPanel.Dock="Top"><Button Content="Open recording…" Click="OpenReplay"/><ComboBox x:Name="ReplayUnits" DisplayMemberPath="Unit" SelectionChanged="ReplayUnitChanged" Width="260"/><Button x:Name="PlayButton" Content="Play" Click="PlayReplay"/><ComboBox x:Name="Speed" SelectedIndex="1"><ComboBoxItem Content="0.25×"/><ComboBoxItem Content="1×"/><ComboBoxItem Content="2×"/><ComboBoxItem Content="4×"/></ComboBox><Button Content="Export displayed range…" Click="ExportReplay"/></WrapPanel>
<TextBlock DockPanel.Dock="Top" x:Name="ReplayHealth" Text="Open a complete recording. Verification and indexing run in the background." TextWrapping="Wrap"/>
<StackPanel DockPanel.Dock="Bottom"><Slider x:Name="Seek" Minimum="0" Maximum="1000" ValueChanged="SeekChanged"/><TextBlock x:Name="ReplayPosition"/><TextBox x:Name="ReplayEvents" IsReadOnly="True" Height="100" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/></StackPanel>
<local:PlotView x:Name="ReplayPlot"/>
</DockPanel></TabItem>
</TabControl>
</DockPanel></Window>
